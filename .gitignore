# ==========================================
# 1. Dependencias y paquetes externos
# ==========================================
node_modules/
.pnp
.pnp.js

# ==========================================
# 2. Archivos de Entorno y Secretos (Crítico)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
secrets.json

# Permitir explícitamente la plantilla pública de variables
!.env.example

# ==========================================
# 3. Artefactos de compilación y salida (Build)
# ==========================================
dist/
build/
out/
.next/

# ==========================================
# 4. Registros y logs del sistema
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ==========================================
# 5. Cobertura de pruebas (Testing / CI)
# ==========================================
coverage/
*.lcov
.nyc_output/

# ==========================================
# 6. Configuración del editor e IDE
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# 7. Archivos del Sistema Operativo
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# ==========================================
# 8. Bases de datos locales y volcados temporales
# ==========================================
*.sqlite
*.sqlite3
*.db
*.sql.gz
